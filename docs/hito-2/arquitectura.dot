digraph G {
  graph [rankdir=TB, fontname="Liberation Serif", fontsize=13, nodesep=0.35, ranksep=0.45, compound=true, bgcolor=white, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor=white, color=black, fontname="Liberation Serif", fontsize=12, margin="0.15,0.08"];
  edge  [color=black, arrowsize=0.7, fontname="Liberation Serif", fontsize=10];

  usuario [label="Estudiante · Entrenador · Administrador\n(navegador o teléfono)", shape=box, style="rounded", penwidth=1.2];

  subgraph cluster_app {
    label="Aplicación Samán Deportivo (Flutter, PWA)  —  patrón MVVM"; labeljust=l; style="rounded"; color=black; penwidth=1.3; fontsize=13;
    subgraph cluster_v { label="Vista"; style="rounded,dashed"; color=gray40; fontsize=11;
      v [label="Pantallas\nLoginView · RegistroView · PerfilView · CatálogoView …", fillcolor="#F2F2F2"]; }
    subgraph cluster_vm { label="Modelo de vista (ViewModel)"; style="rounded,dashed"; color=gray40; fontsize=11;
      vm [label="AuthViewModel · PerfilViewModel · CatálogoViewModel …\n(estado de la pantalla y acciones)", fillcolor="#F2F2F2"]; }
    subgraph cluster_m { label="Modelo"; style="rounded,dashed"; color=gray40; fontsize=11;
      rep [label="Repositorios\nAuthRepository · UsuarioRepository · DeporteRepository\nInscripcionRepository · PagoRepository", fillcolor="#F2F2F2"];
      ent [label="Entidades\nPersona → Estudiante / Entrenador / Administrador\nDeporte · Sesión · Inscripción · Asistencia · Pago", fillcolor="#F2F2F2"];
    }
  }

  subgraph cluster_fb {
    label="Firebase (nube)"; labeljust=l; style="rounded"; color=black; penwidth=1.3; fontsize=13;
    auth [label="Authentication\nregistro, sesión,\ncontraseña"];
    fs   [label="Cloud Firestore\ndatos y reglas\nde seguridad"];
    host [label="Hosting\npublica la PWA\ncon HTTPS"];
    {rank=same; auth; fs; host}
  }
  pago [label="Pasarela de pagos\n(servicio externo)", style="rounded,dashed"];

  usuario -> v [label=" usa "];

  v -> vm [label=" acciones "];
  vm -> v [label=" notifica cambios ", style=dashed];
  vm -> rep;
  rep -> ent [arrowhead=none, style=dotted, label=" crea "];
  rep -> auth;
  rep -> fs;
  rep -> pago;
  rep -> host [style=invis];
}
